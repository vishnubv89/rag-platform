# =============================================================================
# Knowledge Mesh — environment variable template
# Copy this file to .env and fill in real values before running docker compose.
# NEVER commit .env to version control.
# =============================================================================

# LLM provider: "gemini" or "anthropic"
LLM_PROVIDER=gemini

# Gemini — always required for embeddings
GEMINI_API_KEY=your-gemini-api-key-here

# Anthropic — set LLM_PROVIDER=anthropic and provide this key to use Claude
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# NVIDIA NIM (or any OpenAI-compatible API) — set LLM_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-your-key-here
# NVIDIA_BASE_URL defaults to https://integrate.api.nvidia.com/v1
# Override to point at OpenAI, Groq, Together AI, Ollama, etc.

# Admin API key — used by admin-ui and admin API endpoints
ADMIN_SECRET_KEY=change_me_strong_password_here

# PostgreSQL (must match POSTGRES_PASSWORD in docker-compose.yml)
POSTGRES_PASSWORD=change_me_strong_password_here

# MinIO object storage
MINIO_ROOT_PASSWORD=change_me_strong_password_here

# Langfuse observability (generate with: openssl rand -hex 32)
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_SALT=
LANGFUSE_NEXTAUTH_SECRET=

# ClickHouse (internal Langfuse backend)
CLICKHOUSE_PASSWORD=change_me_strong_password_here

# Backend JWT secret (generate with: openssl rand -hex 32)
JWT_SECRET=

# Session secret for admin-ui cookie signing (generate with: openssl rand -hex 32)
SESSION_SECRET=

# Zitadel SSO (optional — leave empty to use local password login only)
# After starting Zitadel, set this to the issuer shown in the discovery doc:
#   curl http://localhost:8088/.well-known/openid-configuration | jq .issuer
# Typically: http://localhost:8088 (dev) or https://auth.yourdomain.com (prod)
ZITADEL_ISSUER=
ZITADEL_FRONTEND_CLIENT_ID=

# Backup retention (optional — defaults shown)
BACKUP_KEEP_DAYS=7
BACKUP_INTERVAL_HOURS=24
